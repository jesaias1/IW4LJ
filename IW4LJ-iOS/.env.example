# Copy to `.env` and set your games root: the folder with the game trees and
# the `.iw4l-server` files that both the game and `make deploy` read.
# Never commit `.env`.
IW4L_GAMES=/path/to/games-root

# Private CA directory for `cargo xtask certs`. Keep it outside the repo.
IW4L_RELEASE_KEY=/path/to/release-ca
