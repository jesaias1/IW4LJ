<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Only with a paid Apple Developer account (the capability has to be
         enabled on the App ID). A match peaks near 3 GB; without this an
         iPhone with 6 GB ends the app at about that point. -->
    <key>com.apple.developer.kernel.increased-memory-limit</key><true/>
    <key>com.apple.developer.kernel.extended-virtual-addressing</key><true/>
    <!-- Hearing a LAN host's broadcast. Apple grants this by request. -->
    <key>com.apple.developer.networking.multicast</key><true/>
</dict>
</plist>
